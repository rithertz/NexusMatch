# Application
APP_NAME=NexusMatch
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL — local development defaults only
POSTGRES_DB=nexusmatch
POSTGRES_USER=nexusmatch
